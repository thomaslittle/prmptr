{
  "name": "prmptr",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 43110",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "tauri:dev:gpu": "tauri dev --features vulkan",
    "test:e2e": "playwright test",
    "test:rust": "cd src-tauri && cargo test --lib",
    "test:all": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:e2e && npm run test:rust",
    "tauri:dev:cuda": "tauri dev --features cuda",
    "tauri:build": "node scripts/stage-native-libs.mjs && tauri build --config src-tauri/tauri.bundle.local.conf.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.105.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-global-shortcut": "^2.4.1",
    "@tauri-apps/plugin-http": "^2.6.0",
    "@tauri-apps/plugin-store": "^2.5.0",
    "@tiptap/extension-link": "^3.32.2",
    "@tiptap/extension-placeholder": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.16.1",
    "tailwind-merge": "^3.7.0",
    "tiptap-markdown": "^0.9.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1",
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
