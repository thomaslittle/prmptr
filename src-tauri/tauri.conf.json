{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PRMPTR",
  "identifier": "com.prmptr.app",
  "version": "0.2.2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:43110",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out",
    "windows": {
      "staticVCRuntime": false
    }
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* ws://localhost:*; object-src 'none'; base-uri 'self'; form-action 'self'"
    },
    "windows": [
      {
        "label": "main",
        "title": "PRMPTR",
        "width": 1400,
        "height": 900,
        "minWidth": 700,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "PRMPTR"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "models/nemo_en_speakerverification_speakernet.onnx": "models/nemo_en_speakerverification_speakernet.onnx",
      "../templates/*.toml": "templates/",
      "models/silero-vad-v6.2-F32.gguf": "models/silero-vad-v6.2-F32.gguf"
    }
  },
  "plugins": {}
}